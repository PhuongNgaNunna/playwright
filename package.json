{
  "name": "worknest-playwright-lite",
  "version": "1.0.0",
  "description": "WorkNest Playwright Test Suite (E2E + API + Visual) — capstone project",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:e2e": "playwright test --project=admin-chromium --project=manager-chromium --project=employee-chromium",
    "test:api": "playwright test --project=api-project",
    "test:visual": "playwright test --project=visual-admin-chromium",
    "test:update-snapshots": "playwright test --project=visual-admin-chromium --update-snapshots",
    "test:ci": "playwright test --project=setup --project=admin-chromium --project=manager-chromium --project=employee-chromium --project=api-project",
    "report:html": "playwright show-report reports/playwright-html",
    "allure:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "allure:open": "allure open reports/allure-report",
    "allure:serve": "allure serve reports/allure-results",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "api",
    "visual",
    "allure",
    "worknest"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.34.1",
    "allure-js-commons": "^3.4.1",
    "allure-playwright": "^3.4.1",
    "typescript": "^5.6.3"
  }
}
